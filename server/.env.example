# Port the API listens on
PORT=4000
# 0.0.0.0 lets phones on the same Wi-Fi reach it. Use 127.0.0.1 behind a reverse proxy on the VPS.
HOST=0.0.0.0
# SQLite file. Back this file up; it is the whole database.
DB_PATH=./data/kakie.db
# Allowed browser origin for the web build. * is fine for local dev.
CORS_ORIGIN=*
# 64 hex chars (openssl rand -hex 32). Encrypts UPI IDs at rest. If unset, a key is generated
# next to the database as data.key. Back it up with the DB: losing it means users re-enter UPI IDs.
DATA_KEY=
