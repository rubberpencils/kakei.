# Port the API listens on
PORT=4000
# 0.0.0.0 lets phones on the same Wi-Fi reach it. Use 127.0.0.1 behind a reverse proxy on the VPS.
HOST=0.0.0.0
# SQLite file. Back this file up; it is the whole database.
DB_PATH=./data/kakei.db
# Key that seals shared expenses and settlements at rest (AES-256-GCM). 32 bytes as base64 or 64 hex characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave it unset and the server creates data.key next to the database. Keep a copy: without the key the data cannot be read.
KAKEI_DATA_KEY=
# Allowed browser origin for the web build. * is fine for local dev.
CORS_ORIGIN=*
# Every account is pro. Leave it on for a self-hosted server. The hosted kakei. server sets it to false and grants pro per account.
KAKEI_EVERYONE_PRO=true
# Play service-account JSON, or a path to that file. Unset means this server does not sell Pro.
GOOGLE_SA_JSON=
# Where to POST { phone, code } when someone resets a password. Signup does not send a code.
# Unset on a self-host prints the reset code in the server log.
SMS_OTP_URL=
# Gemini key for Ask and the Pro weekly digest. Unset answers 501.
GEMINI_API_KEY=
